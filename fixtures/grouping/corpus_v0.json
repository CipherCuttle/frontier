{"schema_version":"frontier-grouping-corpus-v0","authority":{"runtime_selection_authorized":false,"selection_rule":"reject any candidate with a false merge on a frozen NO_GROUP or AMBIGUOUS case; require pair precision >= 1.000000 and group recall >= 0.800000; among survivors maximize group recall, then minimize ambiguity, then prefer lower complexity","minimum_pair_precision":"1.000000","minimum_group_recall":"0.800000","required_properties":["deterministic-replay","point-in-time-no-lookahead","explicit-ambiguous-outcome","episode-provenance-separation","observation-identity-unchanged"],"candidate_families":["canonical-url-v0","exact-text-v0","normalized-title-v0","token-jaccard-v0","simhash-v0","minhash-v0","tfidf-v0","guarded-hybrid-v0"]},"cases":[{"id":"GRP-001","category":"hn_attention_duplicate","expected":"GROUP","left":{"source_id":"hn.frontpage","source_item_key":"hn:100","observed_at":"2026-09-05T10:00:00Z","canonical_url":"https://vendor.example/release/42","title":"Vendor release discussion","signal_roles":["ATTENTION"]},"right":{"source_id":"hn.frontpage","source_item_key":"hn:200","observed_at":"2026-09-05T10:05:00Z","canonical_url":"https://vendor.example/release/42","title":"Launch: product 42","signal_roles":["ATTENTION"]},"rationale":"Two HN attention observations can concern one episode without becoming two factual roots."},{"id":"GRP-002","category":"shared_catalog_false_merge","expected":"NO_GROUP","left":{"source_id":"cisa.kev","source_item_key":"CVE-2026-1000","observed_at":"2026-09-05T10:00:00Z","canonical_url":"https://www.cisa.gov/known-exploited-vulnerabilities-catalog","title":"Widget auth bypass","signal_roles":["PRIMARY_EMISSION","BEHAVIORAL"]},"right":{"source_id":"cisa.kev","source_item_key":"CVE-2026-2000","observed_at":"2026-09-05T10:01:00Z","canonical_url":"https://www.cisa.gov/known-exploited-vulnerabilities-catalog","title":"Router command injection","signal_roles":["PRIMARY_EMISSION","BEHAVIORAL"]},"rationale":"A shared collection URL must not merge distinct provider-native items."},{"id":"GRP-003","category":"same_url_revision","expected":"GROUP","left":{"source_id":"fixture.publisher","source_item_key":"article-42","observed_at":"2026-09-05T10:00:00Z","canonical_url":"https://publisher.example/live-announcement","title":"Vendor launches Atlas platform","text":"Initial launch detail"},"right":{"source_id":"fixture.publisher","source_item_key":"article-42","observed_at":"2026-09-05T10:12:00Z","canonical_url":"https://publisher.example/live-announcement","title":"Vendor launches Atlas platform","text":"Initial launch detail plus correction"},"rationale":"A nearby revision of one substantive announcement can remain in the same episode."},{"id":"GRP-004","category":"same_url_reuse_far","expected":"NO_GROUP","left":{"source_id":"fixture.publisher","source_item_key":"daily-1","observed_at":"2026-08-01T10:00:00Z","canonical_url":"https://publisher.example/daily","title":"Daily bulletin for August 1"},"right":{"source_id":"fixture.publisher","source_item_key":"daily-36","observed_at":"2026-09-05T10:00:00Z","canonical_url":"https://publisher.example/daily","title":"Daily bulletin for September 5"},"rationale":"A URL reused outside the frozen far window is not enough to join episodes."},{"id":"GRP-005","category":"equal_content_mirror","expected":"GROUP","left":{"source_id":"publisher.alpha","source_item_key":"a-42","observed_at":"2026-09-05T10:00:00Z","canonical_url":"https://alpha.example/release","title":"Acme ships deterministic runtime","text":"Acme ships deterministic runtime for local inference."},"right":{"source_id":"mirror.beta","source_item_key":"b-77","observed_at":"2026-09-05T10:03:00Z","canonical_url":"https://beta.example/mirror","title":"Acme ships deterministic runtime","text":"Acme ships deterministic runtime for local inference."},"rationale":"Equal substantive content may support same-episode grouping but says nothing about origin independence."},{"id":"GRP-006","category":"exact_title_cross_source","expected":"GROUP","left":{"source_id":"publisher.alpha","source_item_key":"a-43","observed_at":"2026-09-05T10:00:00Z","canonical_url":"https://alpha.example/security","title":"Project Orion fixes critical parser bug"},"right":{"source_id":"gdelt.frontier","source_item_key":"https://news.example/orion","observed_at":"2026-09-05T10:06:00Z","canonical_url":"https://news.example/orion","title":"Project Orion fixes critical parser bug","signal_roles":["DISCOVERY"]},"rationale":"A substantive exact title close in FRONTIER time is a transparent grouping signal."},{"id":"GRP-007","category":"punctuation_sensitive_alias","expected":"AMBIGUOUS","left":{"source_id":"publisher.alpha","source_item_key":"model-x-2","observed_at":"2026-09-05T10:00:00Z","canonical_url":"https://alpha.example/model-x-2","title":"Model X 2 released"},"right":{"source_id":"publisher.beta","source_item_key":"model-x2","observed_at":"2026-09-05T10:02:00Z","canonical_url":"https://beta.example/model-x2","title":"Model X-2 released"},"rationale":"Punctuation-only token equivalence must remain reversible because punctuation may be semantic."},{"id":"GRP-008","category":"weak_paraphrase","expected":"AMBIGUOUS","left":{"source_id":"publisher.alpha","source_item_key":"press-42","observed_at":"2026-09-05T10:00:00Z","canonical_url":"https://vendor.example/press/42","title":"Vendor launches X"},"right":{"source_id":"gdelt.frontier","source_item_key":"https://news-a.example/x","observed_at":"2026-09-05T10:02:00Z","canonical_url":"https://news-a.example/x","title":"X is here","signal_roles":["DISCOVERY"]},"rationale":"Low lexical overlap is not negative evidence; a possible syndication relation remains unresolved."},{"id":"GRP-009","category":"pypi_version_split","expected":"NO_GROUP","left":{"source_id":"pypi.updates","source_item_key":"pkg/1.0","kind":"ARTIFACT","observed_at":"2026-09-05T10:00:00Z","canonical_url":"https://pypi.org/project/pkg/1.0/","artifact_type":"python-package-release","artifact_name":"pkg","artifact_version":"1.0","signal_roles":["PRIMARY_EMISSION"]},"right":{"source_id":"pypi.updates","source_item_key":"pkg/2.0","kind":"ARTIFACT","observed_at":"2026-09-05T10:10:00Z","canonical_url":"https://pypi.org/project/pkg/2.0/","artifact_type":"python-package-release","artifact_name":"pkg","artifact_version":"2.0","signal_roles":["PRIMARY_EMISSION"]},"rationale":"Different versions of the same artifact are separate release episodes absent explicit linking."},{"id":"GRP-010","category":"hf_version_split","expected":"NO_GROUP","left":{"source_id":"hf.models","source_item_key":"org/model","kind":"ARTIFACT","observed_at":"2026-09-05T10:00:00Z","canonical_url":"https://huggingface.co/org/model","artifact_type":"huggingface-model-repo","artifact_name":"org/model","artifact_version":"sha-a","signal_roles":["PRIMARY_EMISSION"]},"right":{"source_id":"hf.models","source_item_key":"org/model","kind":"ARTIFACT","observed_at":"2026-09-05T12:00:00Z","canonical_url":"https://huggingface.co/org/model","artifact_type":"huggingface-model-repo","artifact_name":"org/model","artifact_version":"sha-b","signal_roles":["PRIMARY_EMISSION"]},"rationale":"Repository identity does not collapse distinct model revision emissions."},{"id":"GRP-011","category":"generic_title_collision","expected":"AMBIGUOUS","left":{"source_id":"hn.frontpage","source_item_key":"hn:301","observed_at":"2026-09-05T10:00:00Z","canonical_url":"https://one.example/launch","title":"Launch","signal_roles":["ATTENTION"]},"right":{"source_id":"hn.frontpage","source_item_key":"hn:302","observed_at":"2026-09-05T10:01:00Z","canonical_url":"https://two.example/launch","title":"Launch","signal_roles":["ATTENTION"]},"rationale":"A generic one-token headline cannot justify grouping across different targets."},{"id":"GRP-012","category":"unicode_nfc","expected":"GROUP","left":{"source_id":"publisher.alpha","source_item_key":"cafe-a","observed_at":"2026-09-05T10:00:00Z","canonical_url":"https://alpha.example/cafe","title":"Café model release today"},"right":{"source_id":"publisher.beta","source_item_key":"cafe-b","observed_at":"2026-09-05T10:01:00Z","canonical_url":"https://beta.example/cafe","title":"Café model release today"},"rationale":"Canonically equivalent Unicode should not create a false split."},{"id":"GRP-013","category":"unicode_confusable","expected":"AMBIGUOUS","left":{"source_id":"publisher.alpha","source_item_key":"openai-a","observed_at":"2026-09-05T10:00:00Z","canonical_url":"https://alpha.example/openai","title":"OpenAI releases compact model"},"right":{"source_id":"publisher.beta","source_item_key":"openai-b","observed_at":"2026-09-05T10:01:00Z","canonical_url":"https://beta.example/openai","title":"ОpenAI releases compact model"},"rationale":"Visual confusables are not identity authority."},{"id":"GRP-014","category":"timestamp_conflict","expected":"GROUP","left":{"source_id":"publisher.alpha","source_item_key":"timestamp-a","observed_at":"2026-09-05T10:20:00Z","canonical_url":"https://alpha.example/atlas","title":"Atlas runtime reaches stable release"},"right":{"source_id":"publisher.beta","source_item_key":"timestamp-b","observed_at":"2026-09-05T10:22:00Z","canonical_url":"https://beta.example/atlas","title":"Atlas runtime reaches stable release"},"rationale":"Source timestamp claims are intentionally absent here; grouping is based on observed-time-safe evidence."},{"id":"GRP-015","category":"same_source_distinct_items","expected":"NO_GROUP","left":{"source_id":"fixture.feed","source_item_key":"item-a","observed_at":"2026-09-05T10:00:00Z","canonical_url":"https://feed.example/index","title":"Kernel patch fixes scheduler crash"},"right":{"source_id":"fixture.feed","source_item_key":"item-b","observed_at":"2026-09-05T10:01:00Z","canonical_url":"https://feed.example/index","title":"Database release adds vector syntax"},"rationale":"Distinct same-source items sharing an index URL must not collapse when content is clearly unrelated."},{"id":"GRP-016","category":"near_high_overlap","expected":"GROUP","left":{"source_id":"publisher.alpha","source_item_key":"atlas-a","observed_at":"2026-09-05T10:00:00Z","canonical_url":"https://alpha.example/atlas","title":"Atlas open runtime launches for local agents"},"right":{"source_id":"publisher.beta","source_item_key":"atlas-b","observed_at":"2026-09-05T10:04:00Z","canonical_url":"https://beta.example/atlas","title":"Atlas open runtime launches for local agent"},"rationale":"High substantive title overlap near in observed time is sufficient for the baseline."},{"id":"GRP-017","category":"far_same_title","expected":"NO_GROUP","left":{"source_id":"publisher.alpha","source_item_key":"monthly-a","observed_at":"2026-07-01T10:00:00Z","canonical_url":"https://alpha.example/july","title":"Orion monthly security release"},"right":{"source_id":"publisher.alpha","source_item_key":"monthly-b","observed_at":"2026-09-05T10:00:00Z","canonical_url":"https://alpha.example/september","title":"Orion monthly security release"},"rationale":"Lexical identity far apart in FRONTIER knowledge time is not enough to join episodes."},{"id":"GRP-018","category":"attention_to_shared_catalog","expected":"AMBIGUOUS","left":{"source_id":"hn.frontpage","source_item_key":"hn:999","observed_at":"2026-09-05T10:00:00Z","canonical_url":"https://www.cisa.gov/known-exploited-vulnerabilities-catalog","title":"CISA added something nasty","signal_roles":["ATTENTION"]},"right":{"source_id":"cisa.kev","source_item_key":"CVE-2026-3000","observed_at":"2026-09-05T10:01:00Z","canonical_url":"https://www.cisa.gov/known-exploited-vulnerabilities-catalog","title":"Storage appliance auth bypass","signal_roles":["PRIMARY_EMISSION","BEHAVIORAL"]},"rationale":"An attention link to a shared catalog cannot be joined to an arbitrary catalog item solely by URL."},{"id":"GRP-019","category":"same_external_root_discovery","expected":"GROUP","left":{"source_id":"gdelt.frontier","source_item_key":"https://vendor.example/release/99","observed_at":"2026-09-05T10:00:00Z","canonical_url":"https://vendor.example/release/99","title":"Vendor unveils Project Nova compiler","signal_roles":["DISCOVERY"]},"right":{"source_id":"publisher.vendor","source_item_key":"release-99","observed_at":"2026-09-05T10:02:00Z","canonical_url":"https://vendor.example/release/99","title":"Vendor unveils Project Nova compiler","signal_roles":["PRIMARY_EMISSION"]},"rationale":"Same target plus substantive semantic agreement can join discovery and primary emission without implying root independence."},{"id":"GRP-020","category":"similar_title_non_equivalence","expected":"AMBIGUOUS","left":{"source_id":"publisher.alpha","source_item_key":"x-a","observed_at":"2026-09-05T10:00:00Z","canonical_url":"https://alpha.example/x","title":"Model X release candidate announced"},"right":{"source_id":"publisher.beta","source_item_key":"x-b","observed_at":"2026-09-05T10:02:00Z","canonical_url":"https://beta.example/x","title":"Model X security incident announced"},"rationale":"Partial title similarity is insufficient to force an episode merge."},{"id":"GRP-021","category":"same_item_changed_content","expected":"GROUP","left":{"source_id":"fixture.publisher","source_item_key":"article-77","observed_at":"2026-09-05T10:00:00Z","canonical_url":"https://publisher.example/article-77","title":"Nebula database release changes replication","text":"Initial claim."},"right":{"source_id":"fixture.publisher","source_item_key":"article-77","observed_at":"2026-09-05T10:20:00Z","canonical_url":"https://publisher.example/article-77","title":"Nebula database release changes replication","text":"Corrected detail."},"rationale":"Changed canonical content remains separate observations but may share one episode."},{"id":"GRP-022","category":"different_item_exact_body","expected":"GROUP","left":{"source_id":"publisher.alpha","source_item_key":"mirror-a","observed_at":"2026-09-05T10:00:00Z","canonical_url":"https://alpha.example/a","title":"New runtime benchmark published","text":"Benchmark reports 42 tokens per second."},"right":{"source_id":"publisher.beta","source_item_key":"mirror-b","observed_at":"2026-09-05T10:02:00Z","canonical_url":"https://beta.example/b","title":"New runtime benchmark published","text":"Benchmark reports 42 tokens per second."},"rationale":"Exact substantive mirror content supports episode grouping only, not provenance claims."}]}
